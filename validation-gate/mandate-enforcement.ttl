@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix padi: <https://padi.io/ontology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

padi:MandateShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path dc:creator ;
        sh:hasValue "S. M. Gitandu, BS" ;
        sh:minCount 1 ;
        sh:message "LIBRARIAN MANDATE: Every concept must be attributed to the Founding Architect." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "DETERMINISTIC RULE: Undefined concepts are prohibited to prevent hallucination." ;
    ] .
