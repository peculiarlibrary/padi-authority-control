padi:InformationScience a skos:Concept ;
    skos:prefLabel "Information Science" ;
    skos:altLabel "Peculiar Librarian" ;
    dc:creator "S. M. Gitandu, BS" ;
    dc:publisher "PADI Private Authority Bureau" ;
    skos:definition "The foundational academic discipline governing this Bureau, specialized in librarianship and semantic interoperability."@en ;
    skos:narrower padi:PADI_Technical_Standard, padi:Agentic_Orchestration .

padi:PADI_Technical_Standard a skos:Concept ;
